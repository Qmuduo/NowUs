# Local-only values. Never reuse these for deployment.
POSTGRES_PASSWORD=local-only-change-for-shared-host
NOWUS_APP_SECRET=local-development-secret-change-this-before-deploy-32-chars
NOWUS_API_PORT=8000
NOWUS_API_BIND_ADDRESS=127.0.0.1
NOWUS_DB_PORT=5432
NOWUS_SMTP_PORT=1025
NOWUS_MAILPIT_PORT=8025
NOWUS_SMTP_FROM=login@nowus.local

# For a real SMTP provider, set these only in a private .env or deployment secret store.
# NOWUS_ENV=production
# NOWUS_DEV_MAILBOX=false
# NOWUS_SMTP_HOST=smtp.example.com
# NOWUS_SMTP_PORT_INTERNAL=587
# NOWUS_SMTP_USERNAME=
# NOWUS_SMTP_PASSWORD=
# NOWUS_SMTP_STARTTLS=true
